051", "property-label": "has_part", "object": "gomodel:6ac817cf00001061/6ac817cf00001065", "annotations": [{"key": "evidence", "value": "gomodel:6ac817cf00001061/6ac817cf00002024", "value-type": "IRI"}, {"key": "evidence", "value": "gomodel:6ac817cf00001061/6ac817cf00002025", "value-type": "IRI"}, {"key": "contributor", "value": "https://orcid.org/0000-0002-5283-6593"}, {"key": "date", "value": "2026-10-15"}, {"key": "providedBy", "value": "https://www.uniprot.org"}]}, {"subject": "gomodel:6ac817cf00001061/6ac817cf00001078", "property": "BFO:0000050", "property-label": "part of", "object": "gomodel:6ac817cf00001061/6ac817cf00001079", "annotations": [{"key": "evidence", "value": "gomodel:6ac817cf00001061/6ac817cf00001990", "value-type": "IRI"}, {"key": "contributor", "value": "https://orcid.org/0000-0002-5283-6593"}, {"key": "date", "value": "2026-10-15"}, {"key": "providedBy", "value": "https://www.uniprot.org"}]}], "annotations": [{"key": "state", "value": "production"}, {"key": "contributor", "value": "https://orcid.org/0000-0002-5283-6593"}, {"key": "date", "value": "2026-10-16"}, {"key": "title", "value": "Visual perception: Glutamate acts on OFF cone bipolar cells via kainate glutamate receptor complex (Human)."}, {"key": "providedBy", "value": "https://www.uniprot.org"}, {"key": "comment", "value": "Comment to reviewer: Output of signaling via glutamate depends on light and dark condition. In the light: less glutamate release by the photoreceptor -> less glutamate in the synaptic cleft means less activation of kainate receptor complex on the OFF cells -> membrane hyperpolarization of OFF cells -> OFF cells are inhibited.\nIn the dark: continuos glutamate release by the photoreceptor -> more glutamate in the synaptic cleft means activation of kainate receptor complex on the OFF cells -> membrane depolarization of OFF cells -> OFF cells are activated.\n\nMost of the signals on the OFF bipolar cells are transmitted by kainate receptors with only a limited contributions of AMPA receptors"}, {"key": "https://w3id.org/biolink/vocab/in_taxon", "value": "NCBITaxon:9606", "value-type": "IRI"}]}